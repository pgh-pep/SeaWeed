<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seaweed_dashboard</name>
  <version>0.0.0</version>
  <description>Base station dashboard for the SeaWeed boat</description>
  <maintainer email="jau63@pitt.edu">jashuga</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>action_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2_ros_py</depend>

  <!-- Not installed by rosdep. Run these once on each computer:
       sudo apt install python3-pyte
       pip install PySide6-Essentials -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
