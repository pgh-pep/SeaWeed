 <class>BaseStationDashboard</class>
 <widget class="QMainWindow" name="BaseStationDashboard">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1445</width>
    <height>756</height>
   </rect>
  </property>
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
    <horstretch>0</horstretch>
    <verstretch>0</verstretch>
   </sizepolicy>
  </property>
  <property name="windowTitle">
   <string>SeaWeed Base Station</string>
  </property>
  <property name="layoutDirection">
   <enum>Qt::LayoutDirection::LeftToRight</enum>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================================
   DASHBOARD - MINIMAL STYLING
   Keep all elements visible, just style colors and fonts
   ============================================================================ */

QMainWindow {
    background-color: #003594;
}

QWidget {
    background-color: #003594;
    color: #FFFFFF;
    font-size: 13pt;
    font-family: &quot;Segoe UI&quot;;
}

QFrame {
    background-color: #003594;
    border: 3px solid #FFB81C;
}

QLabel {
    color: #FFFFFF;
    background-color: transparent;
    font-size: 13pt;
    font-weight: bold;
	border: none;
}

/* Buttons */
QPushButton {
    background-color: #003594;
    color: #FFFFFF;
    border: 3px solid #FFB81C;
    padding: 8px 12px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #001F50;
    border: 3px solid #FFFFFF;
}

QPushButton:pressed {
    background-color: #FFB81C;
    color: #003594;
}

/* E-Stop Button */
#soft_estop {
    background-color: #E74C3C;
    color: #FFFFFF;
    border: 3px solid #FFFFFF;
}

#soft_estop:hover {
    background-color: #C0392B;
}

#soft_estop:pressed {
    background-color: #FFFFFF;
    color: #E74C3C;
}

/* Spinbox */
QSpinBox, QDoubleSpinBox {
    color: #FFFFFF;
    border: 2px solid #003594;
    padding: 6px;
    font-size: 12pt;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 3px solid #FFB81C;
}

/* Combo Box - MINIMAL */
QComboBox {
    color: #FFFFFF;
    border: 2px solid #003594;
    padding: 6px;
    font-size: 12pt;
}

QComboBox:focus {
    border: 3px solid #FFB81C;
}

QComboBox QAbstractItemView {
    color: #FFFFFF;
    selection-background-color: #FFB81C;
    selection-color: #003594;
    font-size: 12pt;
}

/* Line Edit */
QLineEdit {
    color: #FFFFFF;
    border: 2px solid #003594;
    padding: 6px;
    font-size: 12pt;
}

QLineEdit:focus {
    border: 3px solid #FFB81C;
}

/* Text Browser - Black background */
QTextBrowser {
    background-color: #000000;
    color: #FFFFFF;
    border: 3px solid #FFB81C;
    font-size: 11pt;
}

/* Text Edit */
QTextEdit {
    background-color: #000000;
    color: #FFFFFF;
    border: 3px solid #FFB81C;
    font-size: 11pt;
}

/* Plain Text Edit */
QPlainTextEdit {
    background-color: #000000;
    color: #FFFFFF;
    border: 3px solid #FFB81C;
    font-size: 11pt;
}

/* Graphics View - Black for video */
QGraphicsView {
    background-color: #000000;
    border: 3px solid #FFB81C;
}

/* Checkboxes */
QCheckBox {
    color: #FFFFFF;
    font-size: 12pt;
}

QCheckBox::indicator {
    border: 2px solid #FFB81C;
    background: #003594;
}

QCheckBox::indicator:checked {
    background-color: #FFB81C;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #003594;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #FFB81C;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFFFF;
}

QScrollBar:horizontal {
    background-color: #003594;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #FFB81C;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFFFF;
}

/* Tabs */
QTabWidget::pane {
    border: 2px solid #FFB81C;
}

QTabBar::tab {
    background: #1A4D7F;
    color: #FFFFFF;
    padding: 6px 12px;
    border: 1px solid #FFB81C;
    font-size: 12pt;
}

QTabBar::tab:selected {
    background: #FFB81C;
    color: #003594;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 2px solid #FFB81C;
    color: #FFB81C;
    font-size: 12pt;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    color: #FFB81C;
}

QPushButton:checked { background-color: #FFB81C; color: #003594; }</string>
